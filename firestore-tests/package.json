{
  "name": "snapvote-firestore-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Security-rules tests for SnapVote, run against the Firestore emulator.",
  "scripts": {
    "test": "node --test tests/",
    "emulate": "firebase emulators:exec --only firestore --project snapvote-test \"node --test tests/\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.1.0"
  }
}
