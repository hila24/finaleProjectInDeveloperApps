rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // usernames/{lowercase name} -> { uid, username }
    // Publicly readable so the register screen can check availability before an
    // account exists, and so friends can be looked up by name. A name document can
    // only be created (never overwritten), which is what makes names unique.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // users/{uid} – a profile is readable by any signed-in user (names are shown on
    // polls and in search), but only its owner may create or change it.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // The counters (pollsCreated / votesGiven) are always bumped by the owner
      // of the document, so no extra exception is needed here.
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      // users/{uid}/friends/{friendUid} – friendship is mutual and written on both
      // sides at once, so either party may create or remove the pair.
      match /friends/{friendUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, delete: if signedIn() &&
          (request.auth.uid == uid || request.auth.uid == friendUid);
        allow update: if false;
      }
    }

    // polls/{pollId}
    match /polls/{pollId} {
      // Only the owner and the friends captured in visibleTo can read a poll.
      //
      // Ownership is spelled out even though the owner is always inside visibleTo,
      // because rules are not filters: a query is allowed only when its own
      // constraints prove the rule. "הסקרים שלי" asks for ownerId == me and says
      // nothing about visibleTo, so without this branch the whole query is denied
      // and the screen falls back to whatever the local cache happens to hold.
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.visibleTo
      );

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.voteCount == 0
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.images.size() >= 2
        && request.auth.uid in request.resource.data.visibleTo;

      // The owner may edit their own poll (e.g. imagesDeleted after cleanup);
      // an audience member may only move the vote counters forward – by exactly one
      // vote, and only while the poll is still open. Without those last two checks
      // a client could stuff the ballot, or keep counting after the deadline,
      // straight against the database.
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid || (
          request.auth.uid in resource.data.visibleTo &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voteCount', 'tally']) &&
          request.resource.data.voteCount == resource.data.voteCount + 1 &&
          resource.data.deadline > request.time
        )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // polls/{pollId}/images/{imageId} – the full-size Base64 pictures.
      // Only the poll owner may write them; the audience may look.
      match /images/{imageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/polls/$(pollId)).data.visibleTo;
        allow write: if signedIn() && (
          // on create the poll document may not exist yet, so trust the writer and
          // verify ownership as soon as the poll is there
          !exists(/databases/$(database)/documents/polls/$(pollId)) ||
          get(/databases/$(database)/documents/polls/$(pollId)).data.ownerId == request.auth.uid
        );
      }

      // polls/{pollId}/comments/{commentId} – anyone in the audience may write one,
      // and remove their own. The poll owner may remove any comment on their poll.
      match /comments/{commentId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/polls/$(pollId)).data.visibleTo;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.auth.uid in get(/databases/$(database)/documents/polls/$(pollId)).data.visibleTo;
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/polls/$(pollId)).data.ownerId == request.auth.uid
        );
      }

      // polls/{pollId}/votes/{uid} – one document per voter, write once, never edited.
      match /votes/{voterId} {
        // My own vote (the feed checks whether I already voted), or every vote
        // when I am the poll's owner – that is the "מי הצביע" screen.
        allow read: if signedIn() && (
          request.auth.uid == voterId ||
          get(/databases/$(database)/documents/polls/$(pollId)).data.ownerId == request.auth.uid
        );
        allow create: if signedIn()
          && request.auth.uid == voterId
          && request.auth.uid in get(/databases/$(database)/documents/polls/$(pollId)).data.visibleTo
          && get(/databases/$(database)/documents/polls/$(pollId)).data.deadline > request.time;
        allow update: if false;
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/polls/$(pollId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
